# Database (PostgreSQL - Supabase, Neon, Railway or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multisocial?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-change-in-production-min-32-chars"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# Meta Graph API (Instagram & Facebook)
# App created at developers.facebook.com
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_verify_token"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google & YouTube Data API v3
# Credentials created at console.cloud.google.com
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_CREATOR="price_creator_monthly"
STRIPE_PRICE_ID_PRO="price_pro_monthly"
STRIPE_PRICE_ID_AGENCY="price_agency_monthly"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
